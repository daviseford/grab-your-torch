rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Users: read/write own document only, no self-delete
    match /users/{uid} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow create, update: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Seasons: public read (including unauthenticated), admin-only write
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Competitions: authenticated read, creator/admin update, admin delete
    // Once finished is true, it cannot be reverted to false (one-way transition).
    // Team names belong to their owners: a participant (the creator included)
    // may change only their own team_names entry; only an admin may rename
    // another participant's team. Admin SDK bypasses rules for data corrections.
    match /competitions/{competitionId} {
      // Within team_names, nothing changed except (at most) the caller's own key.
      function onlyOwnTeamNameChanged() {
        return request.resource.data.get("team_names", {})
          .diff(resource.data.get("team_names", {}))
          .affectedKeys().hasOnly([request.auth.uid]);
      }

      // Only the team_names map changed, and within it only the caller's own key.
      function isOwnTeamNameEdit() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["team_names"])
          && onlyOwnTeamNameChanged();
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creator_uid == request.auth.uid;
      allow update: if (isAdmin()
          || (isAuthenticated()
            && request.auth.uid == resource.data.creator_uid
            && request.resource.data.creator_uid == resource.data.creator_uid
            && onlyOwnTeamNameChanged())
          || (isAuthenticated() && request.auth.uid in resource.data.participant_uids && isOwnTeamNameEdit()))
        && !(resource.data.finished == true && !(request.resource.data.finished == true));
      allow delete: if isAdmin();

      // Trades: participants propose and resolve trades; the competition doc
      // itself is never mutated by trades. Castaway *ownership* (who currently
      // holds a castaway) cannot be read from the competition doc, so that
      // check stays client-side in validateTrade. Everything these rules CAN
      // check is checked here: authorship, participant membership, document
      // shape, and the status state machine.
      match /trades/{tradeId} {
        function competitionDoc() {
          return get(/databases/$(database)/documents/competitions/$(competitionId)).data;
        }

        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.competition_id == competitionId
          && request.resource.data.offered_by_uid == request.auth.uid
          && request.resource.data.offered_to_uid != request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.offered_by_uid in competitionDoc().participant_uids
          && request.resource.data.offered_to_uid in competitionDoc().participant_uids
          // Document shape. Without these, a client can write a doc that the
          // trades UI cannot render or sort, and `allow delete: if false`
          // means nobody but an admin can remove it again.
          && request.resource.data.season_id == competitionDoc().season_id
          && request.resource.data.created_at is string
          && request.resource.data.offered_castaway_ids is list
          && request.resource.data.requested_castaway_ids is list
          && request.resource.data.offered_castaway_ids.size() > 0
          && request.resource.data.requested_castaway_ids.size() > 0
          && !request.resource.data.offered_castaway_ids.hasAny(request.resource.data.requested_castaway_ids);
        allow update: if isAuthenticated()
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "effective_episode", "resolved_at"])
          // The accepting participant is the one who benefits from an early
          // cutoff, so the cutoff cannot be left to them.
          //
          // Watch-along: the cutoff is the next episode to be revealed, which
          // this rule can derive from the competition doc, so pin it exactly.
          // A client cannot reach back and take points already on the board,
          // nor push the cutoff far out so points never transfer.
          //
          // Live: `current_episode` is null and scoring data is not readable
          // from rules, so only the coarse floor applies. Accepting a trade in
          // a live competition with a hand-written cutoff remains possible for
          // a participant using the SDK directly -- the documented trust
          // boundary for this feature.
          && (request.resource.data.status != "accepted" || (
            request.resource.data.effective_episode is int
            && (competitionDoc().current_episode is int
              ? request.resource.data.effective_episode == competitionDoc().current_episode + 1
              : request.resource.data.effective_episode >= 1)
          ))
          && (
            (request.auth.uid == resource.data.offered_to_uid
              && request.resource.data.status in ["accepted", "rejected"])
            || (request.auth.uid == resource.data.offered_by_uid
              && request.resource.data.status == "canceled")
          );
        allow delete: if false;
      }
    }

    // Season-data collections: all share authenticated-read / admin-write. Keep in sync.

    // Teams

    match /teams/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Team assignments
    match /team_assignments/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Challenges
    match /challenges/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Eliminations
    match /eliminations/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Vote history

    match /vote_history/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Events
    match /events/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Public season pools.
    //
    // Public read is granted by four explicit NON-RECURSIVE matches: the pool
    // config, its meta documents, a standings summary, and a standings overflow
    // page. There is deliberately no `{document=**}` wildcard anywhere under
    // /pools. Rules are additive, so a recursive grant here could not be
    // narrowed by the entries match below -- every entry would become
    // world-readable the moment it was written (KTD6).
    //
    // Entries are readable only by their owner, before AND after the freeze:
    // publishing them post-freeze would expose Firebase uids to signed-out
    // readers, which no collection in this project does. The public leaderboard
    // carries handles, not uids.
    //
    // Nothing under /pools is client-writable except an entrant's own entry.
    // The config in particular is admin-SDK-only: `.env` holds real admin
    // credentials, so a browser session carrying the admin claim must not be
    // able to move the deadline or throw the kill switch (KTD3).
    match /pools/{poolId} {
      function poolExists() {
        return exists(/databases/$(database)/documents/pools/$(poolId));
      }

      function poolData() {
        return get(/databases/$(database)/documents/pools/$(poolId)).data;
      }

      allow read: if true;
      allow write: if false;

      // Job-written counters (entrant count). Public, never client-written.
      match /meta/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Published leaderboard, one document per episode.
      match /standings/{episodeId} {
        allow read: if true;
        allow write: if false;

        // Overflow rows. Its own statement: the parent match is not recursive.
        match /pages/{pageId} {
          allow read: if true;
          allow write: if false;
        }
      }

      // One entry per user, keyed by uid. The document id IS the identity, so
      // there is no inner `uid` field and the shape allowlist forbids one (R6).
      match /entries/{uid} {
        function isOwner() {
          return request.auth != null && request.auth.uid == uid;
        }

        // Account display names are stored as plain text in the legacy
        // handle field. Allow Unicode names and punctuation, but not controls.
        function handleIsValid(handle) {
          return handle is string
            && handle.size() >= 1
            && handle.size() <= 100
            && handle.matches("^[^\\p{C}\\x{2060}-\\x{206f}]+$")
            && handle.matches("^\\S(.*\\S)?$");
        }

        // Shape allowlist, not just field checks. Without hasOnly an entrant
        // could write a `rank` or `total` field a future reader might trust, or
        // an arbitrary payload up to 1 MiB.
        function entryIsValid(pool) {
          return request.resource.data.keys().hasOnly([
              "id", "pool_id", "season_id", "handle",
              "picks", "prop_bets", "created_at", "updated_at"
            ])
            && request.resource.data.keys().hasAll([
              "id", "pool_id", "season_id", "handle",
              "picks", "prop_bets", "created_at", "updated_at"
            ])
            && request.resource.data.id == "pool_entry_" + uid
            && request.resource.data.pool_id == poolId
            && request.resource.data.season_id == pool.season_id
            && handleIsValid(request.resource.data.handle)
            // Picks are matched as whole {castaway_id, full_name} pairs, never
            // by id alone: the remap audit treats the stored name as ground
            // truth, so a deliberately disagreeing pair must not be storable
            // (R23). Roster ids are unique, so pair-matching plus the set-size
            // check is what rules out duplicates.
            && request.resource.data.picks is list
            && request.resource.data.picks.size() == pool.picks_per_entry
            && request.resource.data.picks.toSet().size() == request.resource.data.picks.size()
            && pool.roster.hasAll(request.resource.data.picks)
            // Rules cannot read the TypeScript prop bet question list, so the
            // pool config mirrors the keys and is the authority (KTD3).
            && request.resource.data.prop_bets is map
            && request.resource.data.prop_bets.keys().hasOnly(pool.prop_bet_keys)
            && request.resource.data.prop_bets.values().hasOnly(pool.prop_bet_answers)
            // Pinned to request.time (KTD4): a client-authored timestamp is
            // worthless and browser clocks are not trustworthy. The client must
            // send serverTimestamp().
            && request.resource.data.updated_at == request.time;
        }

        // `status` is the kill switch: it closes the pool with no deploy and no
        // green CI run, so every write condition consumes it (R12).
        function poolIsOpen(pool) {
          return pool.status == "open";
        }

        function beforeFreeze(pool) {
          return pool.freeze_at is timestamp && request.time < pool.freeze_at;
        }

        allow read: if isOwner();

        // Create, update and delete are separate statements on purpose: a
        // clause referencing `resource.data` evaluates against null on create,
        // and `request.resource` is null on delete.
        allow create: if isOwner()
          && poolExists()
          && poolIsOpen(poolData())
          && beforeFreeze(poolData())
          && entryIsValid(poolData())
          && request.resource.data.created_at == request.time;

        // Full edit, only while the pool is open and unfrozen.
        allow update: if isOwner()
          && poolExists()
          && poolIsOpen(poolData())
          && beforeFreeze(poolData())
          && entryIsValid(poolData())
          && request.resource.data.created_at == resource.data.created_at;

        // The handle stays editable after the freeze; nothing else does. The
        // affectedKeys allowlist is what makes a pick change riding along on a
        // rename fail (R5, R9, AE6).
        allow update: if isOwner()
          && poolExists()
          && poolIsOpen(poolData())
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["handle", "updated_at"])
          && handleIsValid(request.resource.data.handle)
          && request.resource.data.updated_at == request.time;

        // Withdrawal closes with the freeze (R9).
        allow delete: if isOwner()
          && poolExists()
          && poolIsOpen(poolData())
          && beforeFreeze(poolData());
      }
    }
  }
}
