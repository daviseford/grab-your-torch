{
  "name": "grab-your-torch",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint --max-warnings 0",
    "preview": "vite preview",
    "format": "yarn prettier . --write",
    "format:check": "yarn prettier . --check",
    "prepush": "yarn format && yarn lint --fix && yarn tsc",
    "ci": "yarn format:check && yarn lint && yarn tsc && yarn tsc:scripts && yarn tsc:rules && yarn test --run && yarn build",
    "test": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-survivor-fantasy-rules \"vitest run --config vitest.rules.config.ts\"",
    "coverage": "vitest run --coverage",
    "deploy:local": "yarn prepush && yarn build && firebase deploy",
    "up": "yarn upgrade-interactive --latest",
    "e2e": "playwright test",
    "e2e:screenshot": "playwright test screenshot-all --project=chromium-desktop",
    "e2e:setup": "playwright test --project=setup",
    "e2e:audit": "playwright test audit-all --project=setup --project=chromium-desktop --project=chromium-mobile",
    "e2e:ui": "playwright test --ui",
    "e2e:trades": "playwright test --config playwright.trades.config.ts",
    "e2e:auth-flows": "firebase emulators:exec --only auth,firestore,database --project demo-auth-flows \"playwright test --config playwright.auth-flows.config.ts\"",
    "seed-competition": "tsx scripts/seed-competition.ts",
    "new-season": "tsx scripts/new-season.ts",
    "sync-season": "tsx scripts/sync-season.ts",
    "push-all-seasons": "tsx scripts/push-all-seasons.ts",
    "optimize-images": "tsx scripts/optimize-images.ts",
    "tsc:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "tsc:rules": "tsc -p rules-tests/tsconfig.json --noEmit",
    "set-admin": "tsx scripts/set-admin-claim.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mantine/core": "^9.0.0",
    "@mantine/form": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@mantine/modals": "^9.0.0",
    "@mantine/notifications": "^9.0.0",
    "@tabler/icons-react": "^3.41.1",
    "d3-shape": "^3.2.0",
    "firebase": "^12.17.1",
    "lodash-es": "^4.18.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@mantine/mcp-server": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@types/d3-shape": "^3.1.8",
    "@types/fontkit": "2.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.28.1",
    "fontkit": "2.0.4",
    "globals": "^17.4.0",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.2",
    "wawoff2": "2.0.1"
  },
  "resolutions": {
    "@babel/core": "^7.29.7",
    "@grpc/grpc-js": "^1.14.4",
    "@protobufjs/utf8": "^1.1.2",
    "@tootallnate/once": "^2.0.1",
    "brace-expansion": "^5.0.9",
    "fast-xml-builder": "^1.1.7",
    "fast-xml-parser": "^5.7.0",
    "**/uuid": "^11.1.1",
    "form-data": "^2.5.6",
    "postcss": "^8.5.26",
    "protobufjs": "^7.5.6",
    "websocket-driver": "^0.7.5"
  }
}
